{
  "name": "iki-forma",
  "version": "2.0.0",
  "description": "Yerel SQLite destekli futbol kariyer oyunu",
  "author": "İki Forma",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/launch-electron.js",
    "dev": "node scripts/launch-electron.js",
    "test": "node --test tests/*.test.js",
    "test:web": "node --test tests/normalize.test.js tests/web-data.test.js tests/game-core.test.js tests/web-model.test.js tests/ipc.test.js",
    "lint": "node scripts/lint.js",
    "data:build": "node scripts/build-database.js",
    "data:update": "node scripts/download-open-data.js && node scripts/import-open-data.js && node scripts/import-curated-careers.js",
    "data:update:wikidata": "node scripts/update-data.js",
    "data:import-open": "node scripts/import-open-data.js",
    "data:curated": "node scripts/import-curated-careers.js",
    "data:verify": "node scripts/verify-data.js",
    "web:export": "node scripts/export-web-data.js",
    "assets:update": "node scripts/update-assets.js",
    "assets:dry-run": "node scripts/update-assets.js --dry-run",
    "web:smoke": "node scripts/launch-smoke.js",
    "web:serve": "npx serve .",
    "build": "npm run build:portable",
    "build:portable": "npm test && npm run lint && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "i18n-iso-countries": "^7.14.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.ikiforma.app",
    "productName": "İki Forma",
    "artifactName": "Iki-Forma.${ext}",
    "compression": "normal",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/football.db",
      "data/clubs.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/football.db",
        "to": "data/football.db"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
